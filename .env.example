NEXT_PUBLIC_DATA_MODE=local
DATA_ACCESS_MODE=local
AUTH_MODE=dev
ANALYSIS_PROVIDER=rule-based
FASTAPI_ML_URL=
SEARCH_PROVIDER=disabled
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=

# PostgreSQL/Supabase connection.
# For Supabase pooler transaction mode:
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@aws-<REGION>.pooler.supabase.com:6543/postgres"
# For Supabase pooler session mode, use port 5432 with the same postgres.<PROJECT_REF> username.
# If the database password contains @ # : / ? & or %, URL-encode it before placing it in DATABASE_URL.
DATABASE_URL=
PGSSLMODE=require
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_USER_EMAIL=dev@uoip.local
